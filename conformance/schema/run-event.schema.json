{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://massive.dev/schema/run-event.schema.json",
  "title": "Local Run Event v1",
  "description": "One JSON object per NDJSON line. Sequence is run-scoped. elapsedMs and durationMs use a monotonic clock; time is UTC. Map completed counts resolved terminal items, including cancelled and undispatched items.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "sequence",
        "runId",
        "time",
        "elapsedMs",
        "planHash",
        "nodeCount"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "run.started"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "planHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "sequence",
        "runId",
        "time",
        "elapsedMs",
        "nodeId"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "step.started"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "sequence",
        "runId",
        "time",
        "elapsedMs",
        "nodeId",
        "attempt",
        "maxAttempts"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "step.attempt.started"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "itemIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "sequence",
        "runId",
        "time",
        "elapsedMs",
        "nodeId",
        "attempt",
        "maxAttempts",
        "durationMs",
        "status",
        "classification"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "step.attempt.finished"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "classification": {
          "enum": [
            "succeeded",
            "error",
            "non-retryable",
            "killed",
            "timeout",
            "contract",
            "infrastructure",
            "cancelled",
            "verification"
          ]
        },
        "itemIndex": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic": {
          "type": "string",
          "maxLength": 2048
        },
        "logTail": {
          "type": "string",
          "maxLength": 8192
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "sequence",
        "runId",
        "time",
        "elapsedMs",
        "nodeId",
        "completed",
        "failed",
        "total"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "map.progress"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "sequence",
        "runId",
        "time",
        "elapsedMs",
        "nodeId",
        "status",
        "durationMs"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "step.finished"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "skipped",
            "not-started"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "diagnostic": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "sequence",
        "runId",
        "time",
        "elapsedMs",
        "status",
        "durationMs"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "run.finished"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "failedNode": {
          "type": "string",
          "minLength": 1
        },
        "exitHook": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeId",
            "status"
          ],
          "properties": {
            "nodeId": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "succeeded",
                "failed"
              ]
            },
            "persistenceDiagnostic": {
              "type": "string",
              "maxLength": 2048
            }
          }
        },
        "diagnostic": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  ]
}
