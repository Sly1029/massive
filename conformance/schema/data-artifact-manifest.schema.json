{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://massive.dev/conformance/schema/data-artifact-manifest.schema.json",
  "title": "Massive DataArtifactManifest",
  "description": "Immutable publication record for one canonical JSON step output. The body becomes visible as a logical output only after this manifest is conditionally created.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "encoding", "producer", "schema", "body"],
  "properties": {
    "kind": { "const": "DataArtifactManifest" },
    "schemaVersion": { "const": 1 },
    "encoding": { "const": "canonical-json-v0" },
    "producer": { "$ref": "#/$defs/producer" },
    "schema": { "$ref": "#/$defs/hashRef" },
    "body": { "$ref": "#/$defs/body" }
  },
  "$defs": {
    "pathSegment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.@:#-]+$",
      "not": { "enum": [".", ".."] }
    },
    "projectKey": {
      "type": "string",
      "description": "Normalized, single-segment project datastore namespace key; it is the SHA-256 digest of the normalized project identity, prefixed with sha256-.",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "mapItemScopeFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mapId", "index"],
      "properties": {
        "kind": { "const": "map-item" },
        "mapId": { "$ref": "#/$defs/pathSegment" },
        "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "executionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames"],
      "properties": {
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mapItemScopeFrame" }
        }
      }
    },
    "hashRef": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectKey", "planHash", "runId", "nodeId", "attempt"],
      "properties": {
        "projectKey": { "$ref": "#/$defs/projectKey" },
        "planHash": { "$ref": "#/$defs/hashRef" },
        "runId": { "$ref": "#/$defs/pathSegment" },
        "nodeId": { "$ref": "#/$defs/pathSegment" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "scope": { "$ref": "#/$defs/executionScope" }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "hash", "size", "contentType"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^blobs/sha256/[0-9a-f]{64}$"
        },
        "hash": { "$ref": "#/$defs/hashRef" },
        "size": { "type": "integer", "minimum": 0 },
        "contentType": { "const": "application/json" }
      }
    }
  }
}
